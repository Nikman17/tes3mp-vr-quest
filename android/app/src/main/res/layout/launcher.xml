<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#14110d"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <!-- ── Header ── -->
        <TextView
            android:id="@+id/launcher_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TES3MP VR"
            android:textSize="30sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:fontFamily="serif"
            android:textColor="#d9a92f"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Morrowind multiplayer &amp; singleplayer for Quest"
            android:textSize="12sp"
            android:letterSpacing="0.04"
            android:textColor="#8d8069"
            android:gravity="center"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="18dp" />

        <!-- ── GAME DATA ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/lc_card"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GAME DATA"
                android:textSize="11sp"
                android:textColor="#d9a92f"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/game_data_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="(not configured)"
                android:textSize="13sp"
                android:textColor="#ff9d3f"
                android:maxLines="2"
                android:ellipsize="middle"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/select_data_button"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Browse…"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textColor="#e8dcc0"
                    android:background="@drawable/lc_btn"
                    android:stateListAnimator="@null"
                    android:layout_marginEnd="10dp" />

                <Button
                    android:id="@+id/manage_mods_button"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Mods &amp; Load Order"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textColor="#e8dcc0"
                    android:background="@drawable/lc_btn"
                    android:stateListAnimator="@null" />
            </LinearLayout>

        </LinearLayout>

        <!-- ── MODE ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/lc_card"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GAME MODE"
                android:textSize="11sp"
                android:textColor="#d9a92f"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:layout_marginBottom="10dp" />

            <RadioGroup
                android:id="@+id/mode_radio_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radio_singleplayer"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:button="@null"
                    android:background="@drawable/lc_segment"
                    android:text="Singleplayer"
                    android:textColor="@color/lc_segment_text"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:checked="true"
                    android:layout_marginEnd="10dp" />

                <RadioButton
                    android:id="@+id/radio_multiplayer"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:button="@null"
                    android:background="@drawable/lc_segment"
                    android:text="Multiplayer"
                    android:textColor="@color/lc_segment_text"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:gravity="center" />

            </RadioGroup>

            <TextView
                android:id="@+id/mode_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Vanilla OpenMW-VR engine — full quest and save compatibility."
                android:textSize="12sp"
                android:textColor="#8d8069"
                android:layout_marginTop="10dp" />

            <EditText
                android:id="@+id/character_name_edit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Character name (skips typing in VR)"
                android:textColor="#f0e8d4"
                android:textColorHint="#6d6250"
                android:textSize="14sp"
                android:inputType="textPersonName"
                android:maxLines="1"
                android:imeOptions="actionDone"
                android:background="@drawable/lc_input"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:layout_marginTop="12dp" />

            <!-- Server fields (multiplayer only) -->
            <LinearLayout
                android:id="@+id/server_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <EditText
                    android:id="@+id/server_ip_edit"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="7"
                    android:hint="Server IP  (192.168.1.100)"
                    android:textColor="#f0e8d4"
                    android:textColorHint="#6d6250"
                    android:textSize="14sp"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:imeOptions="actionDone"
                    android:background="@drawable/lc_input"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:layout_marginEnd="10dp" />

                <EditText
                    android:id="@+id/server_port_edit"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="3"
                    android:hint="Port: 25565"
                    android:textColor="#f0e8d4"
                    android:textColorHint="#6d6250"
                    android:textSize="14sp"
                    android:inputType="number"
                    android:maxLines="1"
                    android:imeOptions="actionDone"
                    android:background="@drawable/lc_input"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- ── VR SETTINGS ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/lc_card"
            android:padding="16dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="VR COMFORT &amp; PERFORMANCE"
                android:textSize="11sp"
                android:textColor="#d9a92f"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp"
                    android:text="Turning"
                    android:textColor="#c9bda2"
                    android:textSize="14sp"
                    android:gravity="center_vertical" />
                <Spinner
                    android:id="@+id/vr_turning_spinner"
                    android:layout_width="0dp"
                    android:layout_weight="2"
                    android:layout_height="44dp"
                    android:background="@drawable/lc_input"
                    android:paddingLeft="12dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp"
                    android:text="Resolution"
                    android:textColor="#c9bda2"
                    android:textSize="14sp"
                    android:gravity="center_vertical" />
                <Spinner
                    android:id="@+id/vr_resolution_spinner"
                    android:layout_width="0dp"
                    android:layout_weight="2"
                    android:layout_height="44dp"
                    android:background="@drawable/lc_input"
                    android:paddingLeft="12dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp"
                    android:text="Refresh rate"
                    android:textColor="#c9bda2"
                    android:textSize="14sp"
                    android:gravity="center_vertical" />
                <Spinner
                    android:id="@+id/vr_refresh_spinner"
                    android:layout_width="0dp"
                    android:layout_weight="2"
                    android:layout_height="44dp"
                    android:background="@drawable/lc_input"
                    android:paddingLeft="12dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp"
                    android:text="Left HUD"
                    android:textColor="#c9bda2"
                    android:textSize="14sp"
                    android:gravity="center_vertical" />
                <Spinner
                    android:id="@+id/vr_hud_spinner"
                    android:layout_width="0dp"
                    android:layout_weight="2"
                    android:layout_height="44dp"
                    android:background="@drawable/lc_input"
                    android:paddingLeft="12dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp"
                    android:text="Graphics"
                    android:textColor="#c9bda2"
                    android:textSize="14sp"
                    android:gravity="center_vertical" />
                <Spinner
                    android:id="@+id/vr_graphics_spinner"
                    android:layout_width="0dp"
                    android:layout_weight="2"
                    android:layout_height="44dp"
                    android:background="@drawable/lc_input"
                    android:paddingLeft="12dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- ── LAUNCH ── -->
        <Button
            android:id="@+id/launch_game_button"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:text="PLAY"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.2"
            android:textColor="#1a1409"
            android:background="@drawable/lc_btn_primary"
            android:stateListAnimator="@null"
            android:layout_marginBottom="10dp" />

        <!-- ── STATUS ── -->
        <TextView
            android:id="@+id/status_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="#ff9d3f"
            android:gravity="center"
            android:layout_marginBottom="10dp" />

        <!-- ── Engine settings link ── -->
        <Button
            android:id="@+id/settings_button"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Advanced engine settings"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textColor="#9d9077"
            android:background="@android:color/transparent"
            android:stateListAnimator="@null" />

    </LinearLayout>
</ScrollView>
